filters:
  and:
    - file.inFolder("一人公司CRM业务/事实")
formulas:
  summary: 'if(what.length > 40, what.slice(0, 40) + "…", what)'
properties:
  formula.summary:
    displayName: 摘要
  who:
    displayName: 谁
  when:
    displayName: 何时
  time:
    displayName: 时刻
  what:
    displayName: 啥
  where:
    displayName: 在哪
  why:
    displayName: 为何
  how:
    displayName: 方式
  howmuch:
    displayName: 多少
views:
  - type: table
    name: 全部事实
    order:
      - file.name
      - when
      - time
      - who
      - where
      - why
      - how
      - howmuch
      - formula.summary
  - type: kanban
    name: 按谁聚合
    groupBy:
      property: who
      direction: ASC
  - type: kanban
    name: 按在哪看板
    groupBy:
      property: where
      direction: ASC
  - type: kanban
    name: 按方式看板
    groupBy:
      property: how
      direction: ASC
  - type: kanban
    name: 按为何看板
    groupBy:
      property: why
      direction: ASC
  - type: table
    name: 时间线
    sortBy:
      property: when
      direction: DESC
    order:
      - when
      - time
      - who
      - where
      - why
      - how
      - howmuch
      - formula.summary
  - type: table
    name: 正值记录
    filters:
      and:
        # 资金主题即"进账/收"；其他主题（体重/里程/读数）本来就是正的，全落在这张
        - howmuch > 0
    order:
      - when
      - time
      - who
      - where
      - why
      - how
      - howmuch
      - formula.summary
  - type: table
    name: 负值记录
    filters:
      and:
        # 资金主题即"出账/支"；非资金主题通常一张都没有——空着就对了
        - howmuch < 0
    order:
      - when
      - time
      - who
      - where
      - why
      - how
      - howmuch
      - formula.summary
