{
  "name": "solofact",
  "private": true,
  "type": "module",
  "version": "0.3.0",
  "description": "Obsidian 上的事实层：契约 + 纯函数核 + 写入路径 CLI",
  "license": "MIT",
  "bin": {
    "solofact": "cli/solofact.js"
  },
  "files": [
    "cli/",
    "core/",
    "contract/"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "plugin": "node esbuild.config.mjs vault-5w2h",
    "build-demo": "node vault-5w2h/build.js",
    "seed-demo": "node vault-5w2h/build.js",
    "audit": "node cli/solofact.js 体检 --vault vault-5w2h",
    "sync-version": "node scripts/sync-version.mjs",
    "pack:plugin": "node scripts/pack-plugin.mjs",
    "pack:demo": "node scripts/pack-demo.mjs",
    "pack:agent": "node scripts/pack-agent.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2"
  }
}
